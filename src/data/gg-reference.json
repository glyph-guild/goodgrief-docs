      "options": []
    },
    {
      "usage": "gg invite",
      "summary": "create a link that adds another person to this organisation",
      "options": []
    },
    {
      "usage": "gg credential add --repo \u003Cslug\u003E|--agent \u003Cname\u003E|--tracker \u003Ckey\u003E|--analysis \u003Ckey\u003E",
