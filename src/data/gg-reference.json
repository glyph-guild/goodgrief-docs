    },
    {
      "usage": "gg board [--all] [--limit \u003Crows\u003E] [--after \u003Ccursor\u003E]",
      "summary": "list proposed work (nominations) waiting for a person",
      "options": []
    },
    {
      "usage": "gg board open \u003Cid\u003E \u003Cwhy\u003E",
