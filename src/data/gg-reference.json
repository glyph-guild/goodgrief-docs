      "options": []
    },
    {
      "usage": "gg decide \u003Cflight\u003E \u003Cobligation\u003E \u003Coutcome\u003E [reason]",
      "summary": "answer a gate: let the flight continue, or turn it down",
      "options": []
    },
    {
      "usage": "gg ground \u003Cflight\u003E \u003Cwhy\u003E",
      "summary": "stop a flight for good and record why",
      "options": []
    },
    {
      "usage": "gg model \u003Cflight\u003E \u003Cmodel\u003E",
      "summary": "move a flight in progress to another model; gg airspace show lists them",
      "options": []
    },
    {
      "usage": "gg take \u003Cflight\u003E [--return \u003Coutcome\u003E [--note \u003Cnote\u003E]]",
      "summary": "take over a flight in person, and hand it back",
      "options": []
    },
    {
      "usage": "gg runner labels",
      "summary": "show what each runner advertises, and its disposition",
      "options": []
    },
    {
      "usage": "gg runner retire \u003Cid|name\u003E",
      "summary": "remove a runner from the fleet permanently",
      "options": []
    },
    {
      "usage": "gg tenant name \u003Cname\u003E",
      "summary": "rename this organisation; only an administrator can do this",
      "options": []
    },
    {
