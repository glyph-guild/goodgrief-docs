      "usage": "gg credential send --runner \u003Cid|name\u003E --repo \u003Cslug\u003E|--agent \u003Cname\u003E|--tracker \u003Ckey\u003E|--analysis \u003Ckey\u003E",
      "summary": "send a credential to one machine that cannot be reached any other way",
      "options": []
    },
