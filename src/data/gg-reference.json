{
  "version": "0.88.44\u002B028a590b0a2942fbc68e1043f4e3161ba2d970e2",
  "commands": [
    {
      "usage": "gg",
      "summary": "open the console",
      "options": []
    },
    {
      "usage": "gg fly \u003Ctext\u003E|--uri \u003Curi\u003E|--ticket \u003Cprovider\u003E#\u003Cid\u003E",
      "summary": "open a flight (a piece of work an agent carries out)",
      "options": [
        {
          "usage": "--repo \u003Cname\u003E",
          "summary": "the repository it is about, by its registered name"
        },
        {
          "usage": "--runner \u003Cid|name\u003E",
          "summary": "run it on one named machine only"
        },
        {
          "usage": "--work-kind \u003Cname\u003E",
          "summary": "the work kind whose rules govern it"
        },
        {
          "usage": "--environment \u003Cname\u003E",
          "summary": "the charted environment it runs in"
        },
        {
          "usage": "--model \u003Cname\u003E",
          "summary": "the model it runs on; gg airspace show lists them"
        },
        {
          "usage": "--attended",
          "summary": "say that a person will watch it while it runs"
        },
        {
          "usage": "--file \u003Crepo\u003E:\u003Cpath\u003E[@ref]",
          "summary": "work from a file in a registered repository, which the runner reads"
        }
      ]
    },
    {
      "usage": "gg flights [--all] [--intent \u003Cprovider\u003E#\u003Cid\u003E|\u003Curi\u003E|\u003Crepo\u003E:\u003Cpath\u003E] [--kind \u003Cwork kind\u003E]",
      "summary": "list flights in progress, or every flight with --all",
      "options": [
        {
          "usage": "--limit \u003Crows\u003E --after \u003Ccursor\u003E",
          "summary": "show one page, and continue from the cursor it prints"
        }
      ]
    },
    {
      "usage": "gg show \u003Cflight\u003E",
      "summary": "show one flight, by number (GG-42) or by id",
      "options": []
    },
    {
      "usage": "gg log \u003Cflight\u003E",
      "summary": "show a flight\u0027s log",
      "options": []
    },
    {
      "usage": "gg facts \u003Cflight\u003E",
      "summary": "show what a flight recorded, and the budget each item counted against",
      "options": []
    },
    {
      "usage": "gg runners",
      "summary": "list this organisation\u0027s runners",
      "options": []
    },
    {
      "usage": "gg watches [--limit \u003Crows\u003E] [--after \u003Ccursor\u003E]",
      "summary": "show how each watch is doing: executor, last report, cost",
      "options": []
    },
    {
      "usage": "gg plan [flight]",
      "summary": "show what must be true before a flight can start",
      "options": []
    },
    {
      "usage": "gg itinerary check \u003Cfile\u003E",
      "summary": "check a plan file and show what would happen to each leg",
      "options": []
    },
    {
      "usage": "gg itinerary propose \u003Cfile\u003E",
      "summary": "propose a plan; nothing starts until a person answers its gate",
      "options": []
    },
    {
      "usage": "gg itinerary tools [--draft \u003Cname\u003E]",
      "summary": "run a tool server that a Claude Code session drafts a plan with",
      "options": []
    },
    {
      "usage": "gg manage tools",
      "summary": "run gg\u0027s management commands as tools for a Claude Code session",
      "options": []
    },
    {
      "usage": "gg mux mark \u003Cworking|waiting|notification\u003E",
      "summary": "record an agent\u0027s state for the mux; its hooks run this, and it always exits 0",
      "options": []
    },
    {
      "usage": "gg itineraries [--intent \u003Ckey\u003E] [--limit \u003Crows\u003E] [--after \u003Ccursor\u003E]",
      "summary": "list every plan and its legs",
      "options": []
    },
    {
      "usage": "gg itinerary show \u003CITN-n\u003E",
      "summary": "show one plan and every leg in full",
