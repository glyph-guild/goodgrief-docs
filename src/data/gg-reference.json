      "options": []
    },
    {
      "usage": "gg board decline \u003Cid\u003E \u003Cwhy\u003E",
      "summary": "decline a waiting nomination",
      "options": []
    },
    {
      "usage": "gg why \u003Cflight\u003E [obligation]",
