    },
    {
      "usage": "gg fleet revoke \u003Cid\u003E",
      "summary": "stop an enrollment token from enrolling any more machines",
      "options": []
    },
    {
      "usage": "gg runner claim|unclaim \u003Cid|name\u003E",
      "summary": "take ownership of a machine, or give it up",
